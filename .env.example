# =========================================================================
# Apex Quant Trading Workstation & Paper Trading Simulator
# Environment Configuration
# =========================================================================
# Copy this file to .env in your project root:
#   cp .env.example .env
#
# When you provide your API keys below, the platform automatically switches
# from local in-memory storage to live Supabase cloud sync and live Upstox v2 feeds.
# =========================================================================

# -------------------------------------------------------------------------
# 1. GROQ AI CLOUD (Llama Prompt Guard 2 & Real-Time Quant Audits)
# -------------------------------------------------------------------------
# Free high-speed key from: https://console.groq.com/keys
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=meta-llama/llama-prompt-guard-2-86m

# -------------------------------------------------------------------------
# 2. SUPABASE CLOUD (Paper Trading Cloud Persistence & User Accounts)
# -------------------------------------------------------------------------
# Obtain from your Supabase project dashboard: https://app.supabase.com/project/_/settings/api
# Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=
# Project Anon / Public Key (eyJhbGciOi...)
VITE_SUPABASE_ANON_KEY=

# -------------------------------------------------------------------------
# 3. UPSTOX API v2 (Live Indian Equities, F&O Derivatives & MCX Commodities)
# -------------------------------------------------------------------------
# Developer Portal: https://developer.upstox.com/
# Access token generated from your Upstox developer console or via OAuth code flow:
VITE_UPSTOX_ACCESS_TOKEN=
# Optional: App API Key & Secret for automated OAuth token renewals
VITE_UPSTOX_API_KEY=
VITE_UPSTOX_API_SECRET=
VITE_UPSTOX_REDIRECT_URI=http://localhost:3000/dashboard
