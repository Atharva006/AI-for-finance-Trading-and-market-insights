# Apex Quant Trading Workstation - Environment Configuration
# Copy this file to .env in your project root:
#   cp .env.example .env

# -------------------------------------------------------------
# 1. UPSTOX API v2 (Live NSE/BSE Equity & Derivatives Execution)
# -------------------------------------------------------------
# Optional in .env — can also be entered directly in the UI via the "Upstox Settings" modal.
# Generate from: https://developer.upstox.com/
VITE_UPSTOX_ACCESS_TOKEN=

# -------------------------------------------------------------
# 2. GROQ AI CLOUD (Strategy Doctor AI & Real-Time Quant Audits)
# -------------------------------------------------------------
# Get your free high-speed Llama 3 API key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=

# -------------------------------------------------------------
# 3. SUPABASE (User Auth & Cloud Strategy / Basket Persistence)
# -------------------------------------------------------------
# Get from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
